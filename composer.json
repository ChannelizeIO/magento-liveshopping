{
    "name": "channelize/liveshopping",
    "description": "Channelize.io live Shopping can help in transforming online sale with complete live stream shopping solution.",
    "type": "magento2-module",
    "version": "2.3.3",
    "license": [
        "OSL-3.0"
    ],
    "autoload": {
        "files": [ "registration.php" ],
        "psr-4": {
            "Channelize\\LiveShopping\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
